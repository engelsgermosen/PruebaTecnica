# En dev, Vite hace de proxy inverso (ver vite.config.js: /api -> http://localhost:5080),
# así que el cliente usa la ruta relativa "/api/v1" y no hay CORS.
# Ajusta el target del proxy en vite.config.js si el API expone otro puerto.
VITE_BACKEND_URL=/api/v1
# En contenedores el mismo valor "/api/v1" se inyecta como build-arg,
# porque nginx hace de proxy inverso hacia el API en el mismo origen.
VITE_APP_NAME="DGII Tax Management"
VITE_API_TIMEOUT=10000
VITE_ENABLE_LOGGING=true
# Credenciales de prueba visibles/precargadas en el login (solo demo).
# "false" para ocultarlas. Opcional: VITE_DEMO_EMAIL / VITE_DEMO_PASSWORD.
VITE_DEMO_CREDENTIALS=true
