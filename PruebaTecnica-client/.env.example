# Desarrollo local (ajustar al puerto que exponga el API, ver Properties/launchSettings.json del backend)
VITE_BACKEND_URL=https://localhost:53230/api/v1
# En contenedores el valor se inyecta como build-arg y vale "/api/v1",
# porque nginx hace de proxy inverso hacia el API en el mismo origen.
VITE_APP_NAME="DGII Tax Management"
VITE_API_TIMEOUT=10000
VITE_ENABLE_LOGGING=true
